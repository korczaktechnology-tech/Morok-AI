{
  "name": "morok-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Morok — assistente pessoal inteligente multiplataforma.",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace=@morok/api & npm run dev --workspace=@morok/client",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write ."
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
