NODE_ENV=development
HOST=0.0.0.0
PORT=10000
CORS_ORIGIN=*
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=morok
LOG_LEVEL=info
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=morok
MODEL_TEMPERATURE=0.4
WEB_TIMEOUT_MS=10000
MAX_FILE_BYTES=10000000

# Secure credential vault (required to use /api/v1/vault and integration secrets)
VAULT_KEY=replace-with-a-long-random-secret
# Optional model integration
MODEL_API_URL=
MODEL_API_KEY=
MODEL_NAME=morok
MODEL_TEMPERATURE=0.4
WEB_TIMEOUT_MS=10000
MAX_FILE_BYTES=10000000
