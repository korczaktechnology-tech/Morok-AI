MODEL_NAME=qwen2.5:0.5b
MODEL_TEMPERATURE=0.4
WEB_TIMEOUT_MS=10000
MAX_FILE_BYTES=10000000

# Optional fallback model gateway
MODEL_FALLBACK_API_URL=
MODEL_FALLBACK_API_KEY=

# Secure credential vault
VAULT_KEY=replace-with-a-long-random-secret
