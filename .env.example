NODE_ENV=development
HOST=0.0.0.0
PORT=10000
CORS_ORIGIN=*
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=MorokAI
LOG_LEVEL=info

# Ollama / OpenAI-compatible model gateway
MODEL_API_URL=http://127.0.0.1:11434/v1
